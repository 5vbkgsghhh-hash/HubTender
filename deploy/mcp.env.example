# Merge variable names into the protected backend env file. Never commit values.
MCP_ENABLED=true
# Gates immediate source-backed BOQ writes from MCP. Leave false until staging UAT.
MCP_WRITE_ENABLED=false
# Shared nomenclature/library creation by engineer or senior roles; OAuth
# nomenclature:create/library:create and per-command confirmation are required.
MCP_CATALOG_WRITE_ENABLED=false
MCP_TEMPLATE_WRITE_ENABLED=false
MCP_AUDIENCE=hubtender-mcp
MCP_ACCESS_TOKEN_TTL_MINUTES=10
MCP_REFRESH_TOKEN_TTL_DAYS=30
MCP_AUTHORIZATION_CODE_TTL_MINUTES=5
MCP_DCR_ENABLED=true
# Optional comma-separated HTTPS hosts allowed to serve CIMD documents.
MCP_CIMD_ALLOWED_HOSTS=
MCP_MAX_REQUEST_BODY_BYTES=1048576
# Required existing setting; public origin without /api.
APP_BASE_URL=https://tender.example
